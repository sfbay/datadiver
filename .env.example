VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_SOCRATA_APP_TOKEN=
# Google Map Tiles API key — powers the photoreal mode of The Last 48. Keep it
# referrer-restricted (localhost + the production domain) and never commit a
# value: local goes in .env.local, production in the Vercel dashboard only.
VITE_GOOGLE_TILES_KEY=
